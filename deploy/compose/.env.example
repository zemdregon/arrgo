# Example environment overrides for the arrgo Docker Compose stack.
# Copy this file to `.env` and adjust the values to suit your setup.

# Container image tags used for the arrgo services and dashboard.
ARRGO_IMAGE=arrgo:dev
ARRGO_DASHBOARD_IMAGE=arrgo-dashboard:dev

# Database configuration for the Postgres service and application connections.
ARRGO_DB_USER=arrgo
ARRGO_DB_PASSWORD=arrgo
ARRGO_DB_NAME=arrgo

# Authentication token configuration for bootstrap access via the dashboard.
ARRGO_BOOTSTRAP_ADMIN_TOKEN=arrgo-admin.devtoken
ARRGO_BOOTSTRAP_ADMIN_LABEL=dashboard
